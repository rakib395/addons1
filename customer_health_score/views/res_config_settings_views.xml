<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_health" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.health</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">

                <app data-string="Customer Health" string="Customer Health" name="customer_health">
                    
                    <block title="Analysis Parameters" name="analysis_setting">
                        <setting string="Time &amp; Gap" help="Set period and expected gap for order analysis">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="x_analysis_days" class="col-lg-4 o_light_label"/>
                                    <field name="x_analysis_days"/>
                                </div>
                                <div class="row">
                                    <label for="x_expected_order_gap" class="col-lg-4 o_light_label"/>
                                    <field name="x_expected_order_gap"/>
                                </div>
                                <div class="row text-muted" invisible="not benchmark_info">
                                    <div class="col-lg-4">Current Benchmark:</div>
                                    <div class="col-lg-8"><field name="benchmark_info" readonly="1"/></div>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Score Thresholds" name="thresholds_setting">
                        <setting string="Status Limits" help="Define health status boundaries">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="x_healthy_threshold" class="col-lg-4 o_light_label"/>
                                    <field name="x_healthy_threshold"/>
                                </div>
                                <div class="row">
                                    <label for="x_critical_threshold" class="col-lg-4 o_light_label"/>
                                    <field name="x_critical_threshold"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Calculation Weights (%)" name="weights_setting">
                        <setting string="Factor Weights" help="Importance of each score in final rating">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="x_order_weight" class="col-lg-4 o_light_label"/>
                                    <field name="x_order_weight"/>
                                </div>
                                <div class="row">
                                    <label for="x_payment_weight" class="col-lg-4 o_light_label"/>
                                    <field name="x_payment_weight"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    
                </app>

            </xpath>
        </field>
    </record>


</odoo>