<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_health" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.health</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Customer Health" string="Customer Health" name="customer_health_score">
                    
                    <block title="Score Thresholds" name="thresholds_setting">
                        <setting string="Health Thresholds" help="Define the limits for healthy and critical status">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="x_healthy_threshold" class="col-lg-4 o_light_label"/>
                                    <field name="x_healthy_threshold"/>
                                </div>
                                <div class="row">
                                    <label for="x_critical_threshold" class="col-lg-4 o_light_label"/>
                                    <field name="x_critical_threshold"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Calculation Weights (%)" name="weights_setting">
                        <setting string="Score Weights" help="Configure how much each factor contributes to the total score">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="x_order_weight" class="col-lg-4 o_light_label"/>
                                    <field name="x_order_weight"/>
                                </div>
                                <div class="row">
                                    <label for="x_payment_weight" class="col-lg-4 o_light_label"/>
                                    <field name="x_payment_weight"/>
                                </div>
                                <div class="row">
                                    <label for="x_revenue_weight" class="col-lg-4 o_light_label"/>
                                    <field name="x_revenue_weight"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <!-- Settings Menu Action -->
    <record id="action_customer_health_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'customer_health_score', 'bin_size': False}</field>
    </record>
</odoo>