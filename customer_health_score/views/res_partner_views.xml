<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Inheritance -->
    <record id="view_partner_form_health_score" model="ir.ui.view">
        <field name="name">res.partner.form.health.score</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook" position="inside">
                    <page string="Health Score Details" name="health_details">
                        <div class="row mt-3">
                            <div class="col-md-5 border-end text-center d-flex flex-column align-items-center justify-content-start">
                                <h3 class="fw-bold text-dark mt-2 mb-0">Health Score</h3>
                                
                                <div class="py-2" style="min-height: 140px;">
                                    <field name="health_score" widget="gauge" options="{'max_value': 100, 'style': 'width:180px; height: 140px;'}"/>
                                </div>

                                <div class="mb-3">
                                    <field name="health_state" widget="badge" 
                                        decoration-danger="health_state == 'critical'" 
                                        decoration-warning="health_state == 'at_risk'" 
                                        decoration-success="health_state == 'healthy'"/>
                                </div>

                                <div class="mt-auto py-2 border-top w-75">
                                    <small class="text-muted d-block">
                                        <i class="fa fa-clock-o me-1"/> 
                                        <strong>Last Update:</strong> 
                                        <field name="last_health_compute" nolabel="1"/>
                                    </small>
                                </div>
                            </div>

                            <div class="col-md-7">
                                <group string="Scoring Factors">
    
                                    <label for="order_frequency_score" string="Order Frequency"/>
                                    <div class="o_row">
                                        <field name="order_frequency_score" widget="progressbar" nolabel="1"/>
                                        <field name="order_frequency_score_text" class="fw-bold text-info ml-2"/>
                                    </div>

                                    
                                    <label for="payment_behavior_score" string="Payment Behavior"/>
                                    <div class="o_row">
                                        <field name="payment_behavior_score" widget="progressbar" nolabel="1"/>
                                        <field name="payment_behavior_status" widget="badge"
                                            decoration-success="payment_behavior_status == 'good'"
                                            decoration-warning="payment_behavior_status == 'average'"
                                            decoration-danger="payment_behavior_status == 'poor'"/>
                                        <field name="payment_delay_info" class="fw-bold ml-2"/>
                                    </div>

                                </group>

                                <div class="alert alert-info mt-3" role="alert">
                                    <i class="fa fa-info-circle me-1"/> 
                                    These scores are calculated like based on the last <strong>90 days</strong> of activity.
                                </div>

                            </div>
                        </div>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <!-- List View Inheritance -->
    <record id="view_partner_tree_health_score" model="ir.ui.view">
        <field name="name">res.partner.list.health.score</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[last()]" position="after">

                <field name="health_score" widget="progressbar" optional="show"/>
                <field name="health_state" 
                       widget="badge" 
                       decoration-danger="health_state == 'critical'" 
                       decoration-warning="health_state == 'at_risk'" 
                       decoration-success="health_state == 'healthy'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Search View Inheritance -->
    <record id="view_res_partner_filter_health_score" model="ir.ui.view">
        <field name="name">res.partner.select.health.score</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">

                <separator/>
                <filter string="Critical Status" name="health_critical" domain="[('health_state', '=', 'critical')]"/>
                <filter string="At Risk Status" name="health_at_risk" domain="[('health_state', '=', 'at_risk')]"/>
                <filter string="Healthy Status" name="health_healthy" domain="[('health_state', '=', 'healthy')]"/>
                <separator/>

                <filter string="By Health Status" name="group_by_health_state" context="{'group_by': 'health_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- Kanban View Inheritance -->
    <record id="view_partner_kanban_health_score" model="ir.ui.view">
        <field name="name">res.partner.kanban.health.score</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="health_state"/>
            </xpath>

            <xpath expr="//templates//field[@name='display_name']" position="after">
                <div class="mt-1">
                    <field name="health_state" widget="badge"
                        decoration-danger="health_state == 'critical'"
                        decoration-warning="health_state == 'at_risk'"
                        decoration-success="health_state == 'healthy'"/>
                </div>
            </xpath>
        </field>
    </record>
    
</odoo>